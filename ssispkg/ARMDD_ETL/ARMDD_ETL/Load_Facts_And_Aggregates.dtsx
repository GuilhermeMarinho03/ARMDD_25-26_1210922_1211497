                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ol.OrderLineID,
    ol.OrderID,
    o.CustomerID,
    o.SiteID,
    o.CountryID,
    o.CurrencyID,
    o.OrderDate,
    CONVERT(VARCHAR(10), o.OrderDate, 23) AS OrderDate_Str,
    o.Address,
    o.City,
    o.State,
    o.Zip,
    ol.ProductID,
    ol.SizeID,
    ol.Quantity,
    ol.UnitPrice,
    (ol.Quantity * ol.UnitPrice) AS LineTotal_Local,
    SUM(ol.Quantity * ol.UnitPrice) 
        OVER (PARTITION BY ol.OrderID) AS TotalOrderValue_Local,
    old.Discount,
    old.PromotionDiscount,
    o.ShippingCost
FROM stg.STG_OrdersLine ol
JOIN stg.STG_Orders o
    ON ol.OrderID = o.OrderID
LEFT JOIN stg.STG_OrdersLineDetails old
    ON ol.OrderLineID = old.OrderLineID;</property>
